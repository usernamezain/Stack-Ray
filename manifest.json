{
    "manifest_version": 3,
    "name": "StackRay",
    "version": "1.0",
    "description": "ProfilerIntel Extension: Tech, Design, Performance, Leads, SEO.",
    "permissions": [
        "activeTab",
        "scripting",
        "sidePanel",
        "storage",
        "tabs",
        "cookies"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "side_panel": {
        "default_path": "popup/popup.html"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Toggle StackRay Side Panel"
        },
        "export-data": {
            "suggested_key": {
                "default": "Ctrl+Shift+E",
                "mac": "Command+Shift+E"
            },
            "description": "Export Profiling Data as JSON"
        }
    },
    "web_accessible_resources": [],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "categories.js",
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}